<?xml version="1.0" encoding="utf-8"?>
<!-- Shown when a dashboard asks for a username and password. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F70F1417"
    android:clickable="true"
    android:focusable="false">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="520dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/signin_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/accent"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/signin_body"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/signin_failed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/signin_failed"
                android:textColor="#FFFF8A80"
                android:textSize="16sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/signin_enter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/menu_button"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="@string/signin_enter_here"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp" />

                <Button
                    android:id="@+id/signin_not_now"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/menu_button"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="@string/signin_not_now"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="56dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/signin_qr"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:importantForAccessibility="yes"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/signin_qr_caption"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
